aws_region  = "ca-central-1"
environment = "sandbox"
account_id  = "222222222222"  # sandbox account ID

# Optional. Local runs only — omit in CI, where GitHub Actions authenticates via OIDC.
# Must be a profile the Terraform AWS provider can read (static keys, SSO, or
# credential_process). A profile using the `aws login` session flow will NOT work.
# See CLAUDE.md → Authentication (local runs).
# aws_profile = "simmerplan-management-tf"

# Custom domain. Keep enable_custom_domain = false for the first apply, then
# delegate the route53_name_servers output at the simmerplan.com apex, flip to
# true, and re-apply. Applying with an undelegated zone hangs on ACM validation.
# domain_name          = "sandbox.simmerplan.com"
# enable_custom_domain = false

# Email for CloudWatch alarm notifications (subscription requires manual confirm).
# alarm_email = "you@example.com"
